# Upstream pins for the Gamuroid melonDS DS build (sourced by the scripts).
# Wrapper: JesseTG/melonds-ds, tag v1.4.0 (GPL-3.0).
WRAPPER_URL=https://github.com/JesseTG/melonds-ds.git
WRAPPER_TAG=v1.4.0
WRAPPER_SHA=f394adbacb5722ee97c1b37c8064da9a25818310
# Engine: JesseTG/melonDS, branch jtg/fix-uninitialized-opengl, pinned by commit (GPL-3.0).
# v1.4.0's FetchDependencies.cmake names only the branch; we pin the tip seen on 2026-11-07.
ENGINE_URL=https://github.com/JesseTG/melonDS.git
ENGINE_BRANCH=jtg/fix-uninitialized-opengl
ENGINE_SHA=16f127dbb587a73371827ce79689c5d237c4b59b

# Configure-time dependencies. melonDS DS v1.4.0 (cmake/FetchDependencies.cmake, wrapper commit above) fetches these by
# tag or short commit with CMake FetchContent into deps/ (build_ios.sh sets FETCHCONTENT_BASE_DIR). Full commit ids they
# resolve to (looked up on 2026-11-09; the tag-named ones, fmt/date/zlib, are tags upstream and could in principle move):
DEP_LIBRETRO_COMMON_URL=https://github.com/libretro/libretro-common
DEP_LIBRETRO_COMMON_SHA=fa8a1b572a444fcb552007019f8caf68281108aa   # fa8a1b5
DEP_EMBED_BINARIES_URL=https://github.com/andoalon/embed-binaries
DEP_EMBED_BINARIES_SHA=078b62beba97e8192c99bfb16d5e17220cfc7598     # 078b62b
DEP_GLM_URL=https://github.com/g-truc/glm
DEP_GLM_SHA=6f14f4792a0cde5d0cf2c910506724d61cb95834                # 6f14f47
DEP_LIBSLIRP_URL=https://github.com/JesseTG/libslirp-mirror
DEP_LIBSLIRP_SHA=e61dbd459c8c06607b3a84694489427e8ec60f17           # e61dbd4
DEP_PNTR_URL=https://github.com/robloach/pntr
