+#ifndef MELONDSDS_GAMUROID_NET_STATE_HPP
+#define MELONDSDS_GAMUROID_NET_STATE_HPP
+
+// Online state of the emulated console for the frontend (Gamuroid protocol P2).
+//
+// Codes: 0 = not associated with the emulated access point,
+//        1 = authenticated, not yet associated,
+//        2 = associated (online).
+//
+// The frontend resolves two C functions from the loaded core:
+//   int  gamuroid_net_state_get(void);
+//   void gamuroid_net_state_listen(void (*listener)(int code));   // NULL stops
+// The listener runs on the thread that runs retro_run (or retro_unload_game),
+// only when the code changes, and must not call back into the core.
+
+namespace melonDS {
+    class NDS;
+}
+
+namespace MelonDsDs::gamuroid {
+    /// Called at retro_load_game: the new session starts offline, silently.
+    void NetStateSessionBegin() noexcept;
+
+    /// Called once per retro_run, after the frame: reports a changed code.
+    void NetStateTick(const melonDS::NDS* nds) noexcept;
+
+    /// Called at retro_unload_game: reports 0 if the session ended online,
+    /// then stays quiet until the next session begins.
+    void NetStateSessionEnd() noexcept;
+
+    /// Called at retro_deinit: forgets the listener.
+    void NetStateForget() noexcept;
+}
+
+extern "C" {
+    __attribute__((visibility("default"))) int gamuroid_net_state_get(void);
+    __attribute__((visibility("default"))) void gamuroid_net_state_listen(void (*listener)(int code));
+}
+
+#endif // MELONDSDS_GAMUROID_NET_STATE_HPP
