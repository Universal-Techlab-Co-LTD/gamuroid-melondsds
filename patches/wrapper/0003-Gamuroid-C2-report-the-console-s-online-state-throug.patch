+
+#include "net_state.hpp"
+
+#include <atomic>
+
+#include <NDS.h>
+
+#include "environment.hpp"
+
+namespace {
+    using Listener = void (*)(int);
+
+    // Written only on the emulation thread; read from any thread by gamuroid_net_state_get.
+    std::atomic<int> LastReported {0};
+
+    // Set from any thread by gamuroid_net_state_listen.
+    std::atomic<Listener> CurrentListener {nullptr};
+
+    // Touched only on the thread that drives the core (load, run, unload, deinit).
+    bool SessionActive = false;
+
+    void Report(int code) noexcept {
+        LastReported.store(code, std::memory_order_release);
+        if (Listener listener = CurrentListener.load(std::memory_order_acquire)) {
+            listener(code);
+        }
+    }
+
+    int ReadCode(const melonDS::NDS* nds) noexcept {
+        if (!nds) {
+            return 0;
+        }
+
+        int code = nds->Wifi.GetAPClientStatus();
+        if (code < 0 || code > 2) {
+            // The access point only knows these three states; anything else counts as offline.
+            return 0;
+        }
+
+        return code;
+    }
+}
+
+void MelonDsDs::gamuroid::NetStateSessionBegin() noexcept {
+    LastReported.store(0, std::memory_order_release);
+    SessionActive = true;
+}
+
+void MelonDsDs::gamuroid::NetStateTick(const melonDS::NDS* nds) noexcept {
+    if (!SessionActive) {
+        return;
+    }
+
+    int code = ReadCode(nds);
+    if (code != LastReported.load(std::memory_order_acquire)) {
+        retro::info("Online state changed to {}", code);
+        Report(code);
+    }
+}
+
+void MelonDsDs::gamuroid::NetStateSessionEnd() noexcept {
+    if (SessionActive && LastReported.load(std::memory_order_acquire) != 0) {
+        retro::info("Session ended while online; reporting offline");
+        Report(0);
+    }
+
+    SessionActive = false;
+    LastReported.store(0, std::memory_order_release);
+}
+
+void MelonDsDs::gamuroid::NetStateForget() noexcept {
+    CurrentListener.store(nullptr, std::memory_order_release);
+    SessionActive = false;
+    LastReported.store(0, std::memory_order_release);
+}
+
+extern "C" int gamuroid_net_state_get(void) {
+    return LastReported.load(std::memory_order_acquire);
+}
+
+extern "C" void gamuroid_net_state_listen(void (*listener)(int code)) {
+    CurrentListener.store(listener, std::memory_order_release);
+}
