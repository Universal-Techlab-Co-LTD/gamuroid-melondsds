+void MelonDsDs::ScreenLayoutData::ResetCustomLayoutSession() noexcept {
+    if (_customLayout) {
+        _dirty = true;
+    }
+
+    _customLayout = std::nullopt;
+    _customMaxSize = uvec2(0);
+    _lastInvalidLayoutValue.clear();
+}
+
+void MelonDsDs::ScreenLayoutData::ApplyCustomLayoutValue(std::string_view value) noexcept {
+    ZoneScopedN(TracyFunction);
+    using namespace MelonDsDs::gamuroid;
+
+    ParsedScreenLayoutValue parsed = ParseScreenLayoutValue(value);
+    switch (parsed.kind) {
+        case ScreenLayoutValueKind::Automatic:
+            if (_customLayout) {
+                retro::info("gamuroid_screen_layout is automatic; returning to the configured screen layouts");
+                _customLayout = std::nullopt;
+                _dirty = true;
+            }
+            return;
+        case ScreenLayoutValueKind::Invalid:
+            // Keep whatever layout is active (the last valid custom one, or the configured ones)
+            if (value != _lastInvalidLayoutValue) {
+                retro::warn("Ignoring invalid gamuroid_screen_layout value ({}): \"{}\"", parsed.reason, value);
+                _lastInvalidLayoutValue = std::string(value);
+            }
+            return;
+        case ScreenLayoutValueKind::Custom:
+            break;
+    }
+
+    const CustomScreenLayout& layout = parsed.layout;
+    if (_customLayout && *_customLayout == layout) {
+        // Same geometry and revision: nothing to do
+        return;
+    }
+
+    // Report a maximum that also holds the canvas turned sideways,
+    // so a rotation only needs a geometry change.
+    unsigned side = max(layout.canvasWidth, layout.canvasHeight);
+    _customMaxSize = glm::max(_customMaxSize, uvec2(side));
+
+    retro::info(
+        "Applying gamuroid_screen_layout: canvas {}x{}, upper {},{},{},{}, lower {},{},{},{}, rev {}",
+        layout.canvasWidth, layout.canvasHeight,
+        layout.upper.x, layout.upper.y, layout.upper.w, layout.upper.h,
+        layout.lower.x, layout.lower.y, layout.lower.w, layout.lower.h,
+        layout.revision
+    );
+    _customLayout = layout;
+    _dirty = true;
+}
+
+/// Maps the native screen (256x192) onto a box in canvas pixels.
+/// An invisible box gets the identity, which is never drawn and never touched.
+static mat3 BoxMatrix(const MelonDsDs::gamuroid::ScreenBox& box) noexcept {
+    using namespace MelonDsDs;
+    if (!box.Visible()) {
+        return mat3(1);
+    }
+
+    return math::ts<float>(
+        vec2(box.x, box.y),
+        vec2(float(box.w) / NDS_SCREEN_WIDTH, float(box.h) / NDS_SCREEN_HEIGHT)
+    );
+}
+
+void MelonDsDs::ScreenLayoutData::UpdateCustomLayout() noexcept {
+    ZoneScopedN(TracyFunction);
+    retro_assert(_customLayout.has_value());
+    const gamuroid::CustomScreenLayout& layout = *_customLayout;
+
+    constexpr array<vec2, 4> baseScreenPoints = {
+        vec2(0, 0),
+        vec2(NDS_SCREEN_WIDTH, 0),
+        vec2(NDS_SCREEN_WIDTH, NDS_SCREEN_HEIGHT),
+        vec2(0, NDS_SCREEN_HEIGHT)
+    };
+
+    topScreenMatrix = BoxMatrix(layout.upper);
+    bottomScreenMatrix = BoxMatrix(layout.lower);
+    bottomScreenMatrixInverse = inverse(bottomScreenMatrix);
+    hybridScreenMatrix = mat3(1);
+    hybridScreenMatrixInverse = mat3(1);
+
+    for (size_t i = 0; i < 4; i++) {
+        transformedScreenPoints[i] = topScreenMatrix * vec3(baseScreenPoints[i], 1);
+        transformedScreenPoints[i + 4] = bottomScreenMatrix * vec3(baseScreenPoints[i], 1);
+        transformedScreenPoints[i + 8] = hybridScreenMatrix * vec3(baseScreenPoints[i], 1);
+    }
+
+    // The frame is exactly the canvas; the frontend reports the pointer across all of it
+    bufferSize = uvec2(layout.canvasWidth, layout.canvasHeight);
+    topScreenTranslation = uvec2(max(layout.upper.x, 0), max(layout.upper.y, 0));
+    bottomScreenTranslation = uvec2(max(layout.lower.x, 0), max(layout.lower.y, 0));
+    hybridScreenTranslation = uvec2(0);
+    pointerMatrix = math::ts<float>(vec2(bufferSize) / 2.0f, vec2(bufferSize) / (2.0f * RETRO_MAX_POINTER_COORDINATE<float>));
+
+    // The skin decides where the screens go; never rotate the output
+    // (a rotation to normal may "fail" even though it's the default, as in Update)
+    retro::set_screen_rotation(retro::ScreenOrientation::Normal);
+    orientation = retro::ScreenOrientation::Normal;
+
+    _dirty = false;
+}
