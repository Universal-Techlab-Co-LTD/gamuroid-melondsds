+#ifndef MELONDSDS_GAMUROID_SCREEN_LAYOUT_VALUE_HPP
+#define MELONDSDS_GAMUROID_SCREEN_LAYOUT_VALUE_HPP
+
+// Value of the core option "gamuroid_screen_layout" (Gamuroid protocol P1, format version 1).
+//
+//   auto | <empty>                       -> the core's own layout options apply
+//   L1;canvas=WxH;upper=x,y,w,h|none;lower=x,y,w,h|none[;rev=n]
+//
+// Fields after "L1" may come in any order; unknown fields are ignored;
+// a missing, duplicated or malformed required field makes the whole value invalid.
+// A box with zero width or height is the same as "none".
+// This header has no dependencies on the rest of the core, so it can be unit-tested on the host.
+
+#include <cstdint>
+#include <string_view>
+
+namespace MelonDsDs::gamuroid {
+    constexpr unsigned SCREEN_LAYOUT_MAX_CANVAS = 8192;
+    constexpr unsigned SCREEN_LAYOUT_MAX_BOX = 16384;
+
+    /// A screen box in canvas pixels, origin top-left.
+    /// Not visible when its width or height is 0.
+    struct ScreenBox {
+        int32_t x = 0;
+        int32_t y = 0;
+        int32_t w = 0;
+        int32_t h = 0;
+
+        [[nodiscard]] bool Visible() const noexcept { return w > 0 && h > 0; }
+        bool operator==(const ScreenBox& other) const noexcept {
+            return x == other.x && y == other.y && w == other.w && h == other.h;
+        }
+        bool operator!=(const ScreenBox& other) const noexcept { return !(*this == other); }
+    };
+
+    struct CustomScreenLayout {
+        uint32_t canvasWidth = 0;
+        uint32_t canvasHeight = 0;
+        /// The console's primary display (DS top screen).
+        ScreenBox upper {};
+        /// The console's touch display (DS bottom screen).
+        ScreenBox lower {};
+        uint32_t revision = 0;
+
+        bool operator==(const CustomScreenLayout& other) const noexcept {
+            return canvasWidth == other.canvasWidth && canvasHeight == other.canvasHeight &&
+                upper == other.upper && lower == other.lower && revision == other.revision;
+        }
+        bool operator!=(const CustomScreenLayout& other) const noexcept { return !(*this == other); }
+    };
+
+    enum class ScreenLayoutValueKind {
+        /// "auto" or empty: use the core's own layout.
+        Automatic,
+        /// A valid custom layout.
+        Custom,
+        /// Malformed; see the reason.
+        Invalid,
+    };
+
+    struct ParsedScreenLayoutValue {
+        ScreenLayoutValueKind kind = ScreenLayoutValueKind::Automatic;
+        CustomScreenLayout layout {};
+        /// Static string; set when kind is Invalid.
+        const char* reason = nullptr;
+    };
+
+    [[nodiscard]] ParsedScreenLayoutValue ParseScreenLayoutValue(std::string_view value) noexcept;
+}
+
+#endif // MELONDSDS_GAMUROID_SCREEN_LAYOUT_VALUE_HPP
