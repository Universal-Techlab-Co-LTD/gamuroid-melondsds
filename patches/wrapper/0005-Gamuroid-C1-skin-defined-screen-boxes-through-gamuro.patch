+#include "screen_layout_value.hpp"
+
+namespace {
+    using MelonDsDs::gamuroid::ParsedScreenLayoutValue;
+    using MelonDsDs::gamuroid::ScreenBox;
+    using MelonDsDs::gamuroid::ScreenLayoutValueKind;
+    using std::string_view;
+
+    ParsedScreenLayoutValue Invalid(const char* reason) noexcept {
+        ParsedScreenLayoutValue result;
+        result.kind = ScreenLayoutValueKind::Invalid;
+        result.reason = reason;
+        return result;
+    }
+
+    bool IsAllowedCharacter(char c) noexcept {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || c == '=' || c == ',' || c == ';' || c == 'L';
+    }
+
+    /// Unsigned decimal integer, digits only, no sign; false on overflow past max or on any other character.
+    bool ParseDecimal(string_view text, uint64_t max, uint64_t& out) noexcept {
+        if (text.empty()) {
+            return false;
+        }
+
+        uint64_t value = 0;
+        for (char c : text) {
+            if (c < '0' || c > '9') {
+                return false;
+            }
+
+            value = value * 10 + static_cast<uint64_t>(c - '0');
+            if (value > max) {
+                // Also stops any overflow of the accumulator, since max is far below 2^63.
+                return false;
+            }
+        }
+
+        out = value;
+        return true;
+    }
+
+    /// "WxH", each 1..SCREEN_LAYOUT_MAX_CANVAS
+    bool ParseCanvas(string_view text, uint32_t& width, uint32_t& height) noexcept {
+        size_t separator = text.find('x');
+        if (separator == string_view::npos) {
+            return false;
+        }
+
+        uint64_t w = 0;
+        uint64_t h = 0;
+        if (!ParseDecimal(text.substr(0, separator), MelonDsDs::gamuroid::SCREEN_LAYOUT_MAX_CANVAS, w) ||
+            !ParseDecimal(text.substr(separator + 1), MelonDsDs::gamuroid::SCREEN_LAYOUT_MAX_CANVAS, h)) {
+            return false;
+        }
+
+        if (w == 0 || h == 0) {
+            return false;
+        }
+
+        width = static_cast<uint32_t>(w);
+        height = static_cast<uint32_t>(h);
+        return true;
+    }
+
+    /// "none" or "x,y,w,h", each 0..SCREEN_LAYOUT_MAX_BOX
+    bool ParseBox(string_view text, ScreenBox& box) noexcept {
+        if (text == "none") {
+            box = ScreenBox {};
+            return true;
+        }
+
+        uint64_t numbers[4] {};
+        for (int i = 0; i < 4; i++) {
+            size_t comma = text.find(',');
+            string_view part = (i < 3) ? text.substr(0, comma) : text;
+            if (i < 3 && comma == string_view::npos) {
+                return false;
+            }
+
+            if (!ParseDecimal(part, MelonDsDs::gamuroid::SCREEN_LAYOUT_MAX_BOX, numbers[i])) {
+                // (A fifth number leaves a comma in the last part, which fails here too.)
+                return false;
+            }
+
+            if (i < 3) {
+                text.remove_prefix(comma + 1);
+            }
+        }
+
+        box.x = static_cast<int32_t>(numbers[0]);
+        box.y = static_cast<int32_t>(numbers[1]);
+        box.w = static_cast<int32_t>(numbers[2]);
+        box.h = static_cast<int32_t>(numbers[3]);
+
+        if (!box.Visible()) {
+            // Zero width or height means the same as "none"
+            box = ScreenBox {};
+        }
+
+        return true;
+    }
+}
+
+ParsedScreenLayoutValue MelonDsDs::gamuroid::ParseScreenLayoutValue(string_view value) noexcept {
+    if (value.empty() || value == "auto") {
+        return ParsedScreenLayoutValue {};
+    }
+
+    for (char c : value) {
+        if (!IsAllowedCharacter(c)) {
+            return Invalid("unexpected character");
+        }
+    }
+
+    if (value.back() == ';') {
+        // A trailing empty field is ignored
+        value.remove_suffix(1);
+    }
+
+    bool haveCanvas = false;
+    bool haveUpper = false;
+    bool haveLower = false;
+    bool haveRevision = false;
+    ParsedScreenLayoutValue result;
+    result.kind = ScreenLayoutValueKind::Custom;
+
+    bool first = true;
+    while (true) {
+        size_t end = value.find(';');
+        string_view field = value.substr(0, end);
+
+        if (first) {
+            if (field != "L1") {
+                return Invalid("unsupported format version");
+            }
+            first = false;
+        }
+        else {
+            size_t equals = field.find('=');
+            if (field.empty() || equals == string_view::npos || equals == 0) {
+                return Invalid("malformed field");
+            }
+
+            string_view name = field.substr(0, equals);
+            string_view text = field.substr(equals + 1);
+
+            if (name == "canvas") {
+                if (haveCanvas) return Invalid("duplicate canvas");
+                if (!ParseCanvas(text, result.layout.canvasWidth, result.layout.canvasHeight)) return Invalid("malformed canvas");
+                haveCanvas = true;
+            }
+            else if (name == "upper") {
+                if (haveUpper) return Invalid("duplicate upper");
+                if (!ParseBox(text, result.layout.upper)) return Invalid("malformed upper");
+                haveUpper = true;
+            }
+            else if (name == "lower") {
+                if (haveLower) return Invalid("duplicate lower");
+                if (!ParseBox(text, result.layout.lower)) return Invalid("malformed lower");
+                haveLower = true;
+            }
+            else if (name == "rev") {
+                uint64_t revision = 0;
+                if (haveRevision) return Invalid("duplicate rev");
+                if (!ParseDecimal(text, UINT32_MAX, revision)) return Invalid("malformed rev");
+                result.layout.revision = static_cast<uint32_t>(revision);
+                haveRevision = true;
+            }
+            else {
+                // Unknown field: ignored, for forward compatibility
+            }
+        }
+
+        if (end == string_view::npos) {
+            break;
+        }
+
+        value.remove_prefix(end + 1);
+    }
+
+    if (!haveCanvas) return Invalid("missing canvas");
+    if (!haveUpper) return Invalid("missing upper");
+    if (!haveLower) return Invalid("missing lower");
+
+    return result;
+}
