+void MelonDsDs::SoftwareRenderState::DrawScreenInBox(const uint32_t* screen, const gamuroid::ScreenBox& box) noexcept {
+    ZoneScopedN(TracyFunction);
+
+    if (!box.Visible()) {
+        return;
+    }
+
+    // Clip the box to the output; the boxes come from the frontend and may lie partly (or entirely) outside it.
+    const int64_t outWidth = buffer.Width();
+    const int64_t outHeight = buffer.Height();
+    const int64_t x0 = std::max<int64_t>(box.x, 0);
+    const int64_t y0 = std::max<int64_t>(box.y, 0);
+    const int64_t x1 = std::min<int64_t>(int64_t(box.x) + box.w, outWidth);
+    const int64_t y1 = std::min<int64_t>(int64_t(box.y) + box.h, outHeight);
+    if (x0 >= x1 || y0 >= y1) {
+        return;
+    }
+
+    // Nearest neighbour: output pixel i of the box samples source pixel floor(i * native / box size)
+    const size_t visibleWidth = static_cast<size_t>(x1 - x0);
+    boxColumnMap.resize(visibleWidth);
+    for (size_t i = 0; i < visibleWidth; i++) {
+        int64_t boxColumn = x0 + int64_t(i) - box.x;
+        int64_t source = (boxColumn * NDS_SCREEN_WIDTH) / box.w;
+        boxColumnMap[i] = static_cast<uint16_t>(std::min<int64_t>(source, NDS_SCREEN_WIDTH - 1));
+    }
+
+    int64_t previousSourceRow = -1;
+    for (int64_t y = y0; y < y1; y++) {
+        int64_t sourceRow = std::min<int64_t>(((y - box.y) * NDS_SCREEN_HEIGHT) / box.h, NDS_SCREEN_HEIGHT - 1);
+        uint32_t* out = buffer[static_cast<unsigned>(y)] + x0;
+
+        if (sourceRow == previousSourceRow) {
+            // Upscaling repeats rows; copy the one we just made
+            memcpy(out, buffer[static_cast<unsigned>(y - 1)] + x0, visibleWidth * sizeof(uint32_t));
+            continue;
+        }
+
+        const uint32_t* in = screen + sourceRow * NDS_SCREEN_WIDTH;
+        for (size_t i = 0; i < visibleWidth; i++) {
+            out[i] = in[boxColumnMap[i]];
+        }
+        previousSourceRow = sourceRow;
+    }
+}
